<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Feedback</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,650&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIStudentFeedback.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var path = Context.Request.Path.Value ?? "";
        var onDashboard = path.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase);
    }
    <header class="topbar">
        <div class="shell topbar-inner">
            <a class="brand" asp-page="/Feedback/Index">
                <span class="brand-mark" aria-hidden="true">SF</span>
                Student Feedback
            </a>
            <nav class="nav-links" aria-label="Main">
                <a class="@(!onDashboard ? "is-active" : null)" asp-page="/Feedback/Index">Submit</a>
                <a class="@(onDashboard ? "is-active" : null)" asp-page="/Dashboard/Index">Dashboard</a>
            </nav>
        </div>
    </header>

    <main class="shell page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell">Student Feedback</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
